# Kopiraj u .env i popuni.
PORT=4000

# Nasumičan dugačak string (npr. iz `openssl rand -hex 32`) — čuva sesije klijenata.
JWT_SECRET=

# Javna URL adresa servera (koristi se za linkove ka uploaded slikama).
# Kad dobiješ domen, ovde ide npr. https://api.olgito.rs
PUBLIC_BASE_URL=http://localhost:4000

# Ako su oba popunjena i još ne postoji nijedan admin nalog, server će ga
# automatski napraviti pri prvom pokretanju (Olgičin nalog).
ADMIN_EMAIL=
ADMIN_PASSWORD=
