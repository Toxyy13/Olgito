rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && myUser().role == 'admin';
    }

    function isApprovedClient() {
      return isSignedIn() && myUser().role == 'client' && myUser().accountStatus == 'approved';
    }

    // --- users ---
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // Nalog se sam kreira samo prilikom prve prijave, uvek kao klijent na čekanju.
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == 'client'
        && request.resource.data.accountStatus == 'pending';
      // Klijent sme da menja samo svoj profil (ne role/accountStatus); admin sme sve.
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.accountStatus == resource.data.accountStatus
      );
      allow delete: if isAdmin();
    }

    // --- services (cenovnik) ---
    match /services/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- radno vreme ---
    match /workingHours/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /workingHoursOverrides/{date} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /blockedSlots/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- javna dostupnost (bez imena klijenata) ---
    // Napomena: klijenti pišu direktno ovde u istoj transakciji kad zakazuju/otkazuju
    // (radi atomske provere da slot nije zauzet). To je namerno pojednostavljenje za
    // manji obim korišćenja — vidi README za napomenu o mogućem budućem hardening-u
    // (prebacivanje rezervacije u Cloud Function callable).
    match /availability/{date} {
      allow read: if isSignedIn();
      allow write: if isApprovedClient() || isAdmin();
    }

    // --- termini ---
    match /appointments/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.clientId == request.auth.uid);
      allow create: if isApprovedClient()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status == 'zakazano';
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.clientId == request.auth.uid &&
        request.resource.data.status in ['potvrdjeno', 'otkazano']
      );
      allow delete: if false;
    }

    // --- hitni zahtevi ---
    match /urgentRequests/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.clientId == request.auth.uid);
      allow create: if isApprovedClient() && request.resource.data.clientId == request.auth.uid;
      allow update: if isAdmin();
    }

    // --- zahtevi za pomeranje termina (Olgica -> klijent) ---
    match /rescheduleRequests/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.clientId == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && resource.data.clientId == request.auth.uid);
    }
  }
}
