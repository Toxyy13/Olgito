{
  "expo": {
    "name": "Olgito",
    "slug": "Olgito",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "olgito",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.olgito.app"
    },
    "android": {
      "package": "com.olgito.app",
      "adaptiveIcon": {
        "backgroundColor": "#555861",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Olgito treba pristup galeriji da bi postavio/la profilnu sliku."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#FF6F59"
        }
      ],
      "expo-secure-store"
    ]
  }
}
